# 评测运行配置。复制为 .env 后填写；.env 已被 git 忽略，不要提交。

# ── 被测系统的模型服务（所有产品共用）────────────────────────────
SUT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUT_API_KEY=sk-ws-xxxxxxxx

SUT_LLM_MODEL=deepseek-v4.1-flash-1017
# 仅作记录：模型上下文窗口。
SUT_LLM_CONTEXT_WINDOW=1000000


# embedding：没有快照 id，记录模型名和维度；只用于需要外部 embedding 的产品。
SUT_EMBEDDING_MODEL=qwen3.7-text-embedding
SUT_EMBEDDING_DIMENSIONS=1024

# ── 标注与判定（代替人工，不是被测对象；不能与被测 LLM 相同）──────────
# 仅作记录：命令行通过 --annotator / --model / --reasoning-effort 显式传参，代码不读这几项。
# 选型依据见 docs/judge-selection.md。
ANNOTATOR_CLI=codex
ANNOTATOR_MODEL=gpt-6.1-sol
ANNOTATOR_REASONING_EFFORT=high
JUDGE_CLI=codex
JUDGE_MODEL=gpt-6.1-sol
JUDGE_REASONING_EFFORT=low
